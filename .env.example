# Copy this file to .env for local shell usage, or to /etc/miniclaw/miniclaw.env
# for systemd EnvironmentFile usage.
#
# MiniClaw does not auto-load .env files by itself. For ad-hoc shell runs, use:
#   set -a && source ./.env && set +a

# Paths
MINICLAW_HOME=/var/lib/miniclaw
MINICLAW_WORKSPACE=/var/lib/miniclaw/workspace
MINICLAW_MCP_CONFIG_PATH=/etc/miniclaw/mcp.json

# Model
MINICLAW_API_KEY=
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# Legacy alias. If both are set, MINICLAW_API_URL wins.
MINICLAW_API_URL=
MINICLAW_MODEL=MiniMax-M2.7
MINICLAW_TEMPERATURE=0.7
MINICLAW_MAX_TOKENS=8192
MINICLAW_REQUEST_TIMEOUT=120
MINICLAW_MAX_TOOL_ITERATIONS=100

# MCP
MINICLAW_ENABLE_MCP=false
MINICLAW_MCP_BASE_PATH=
MINICLAW_MCP_RESOURCE_MODE=url

# Gateway
MINICLAW_GATEWAY_CHANNEL=weixin

# QQ gateway
MINICLAW_QQ_APP_ID=
MINICLAW_QQ_TOKEN=
MINICLAW_QQ_APP_SECRET=
MINICLAW_QQ_API_BASE=https://api.sgroup.qq.com
MINICLAW_QQ_WEBHOOK_HOST=127.0.0.1
MINICLAW_QQ_WEBHOOK_PORT=8080
MINICLAW_QQ_WEBHOOK_PATH=/webhook/qq
MINICLAW_QQ_AUTH_CALLBACK_PATH=/qq-callback
MINICLAW_QQ_ALLOW_USERS=
MINICLAW_QQ_ALLOW_GROUPS=
MINICLAW_QQ_PROCESSING_TEXT=收到，处理中，请稍候。

# Weixin gateway
MINICLAW_WEIXIN_API_BASE=https://ilinkai.weixin.qq.com
MINICLAW_WEIXIN_CDN_BASE=https://novac2c.cdn.weixin.qq.com/c2c
# Optional when you prefer direct token injection over QR login.
MINICLAW_WEIXIN_TOKEN=
# Optional when selecting one stored account from workspace/state/weixin/accounts.
MINICLAW_WEIXIN_ACCOUNT_ID=
MINICLAW_WEIXIN_ALLOW_USERS=
MINICLAW_WEIXIN_PROCESSING_TEXT=收到，处理中，请稍候。

# Memory
MINICLAW_MEMORY_RECENT_DAYS=2
MINICLAW_MEMORY_RECENT_CHARS=1600
MINICLAW_MEMORY_SUMMARY_MAX_LINES=20
MINICLAW_MEMORY_SUMMARY_MAX_CHARS=2000
MINICLAW_MEMORY_DAILY_ENTRY_MAX_CHARS=500
MINICLAW_MEMORY_SIGNIFICANCE_THRESHOLD=3
MINICLAW_MEMORY_PRUNE_KEEP_DAYS=14