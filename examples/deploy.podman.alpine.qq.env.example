# Copy this file to ./.deploy.podman.qq.env, adjust values if needed, then run:
#   set -a && source ./.deploy.podman.qq.env && set +a
#   ./scripts/deploy_bl.sh
#
# This template targets the remote bl server. `deploy_bl.sh` will build locally,
# sync to the remote repo, then run Podman Alpine on that server.

MINICLAW_DEPLOY_MODE=podman-alpine

# SSH target
MINICLAW_DEPLOY_HOST=bl
MINICLAW_REMOTE_USER=root
MINICLAW_REMOTE_HOME=/root
MINICLAW_REMOTE_REPO=/bl/project/miniclaw/repo

MINICLAW_GATEWAY_CHANNEL=qq
MINICLAW_LINUX_ARCH=amd64

# Podman build and runtime identity.
MINICLAW_PODMAN_IMAGE=miniclaw:alpine
MINICLAW_PODMAN_CONTAINER=miniclaw-qq

# Remote config and persistent state for this container.
MINICLAW_REMOTE_ENV_FILE=/etc/miniclaw/miniclaw-qq.env
MINICLAW_REMOTE_CONFIG=/root/.config/miniclaw/config
MINICLAW_REMOTE_MCP_CONFIG=/root/.config/miniclaw/mcp.json
MINICLAW_REMOTE_APP_HOME=/var/lib/miniclaw/qq
MINICLAW_REMOTE_WORKSPACE=/var/lib/miniclaw/qq/workspace

MINICLAW_PODMAN_STATE_ROOT=/var/lib/miniclaw/qq
MINICLAW_PODMAN_ENV_FILE=/etc/miniclaw/miniclaw-qq.env
MINICLAW_PODMAN_HOME=/var/lib/miniclaw/qq

# Host port published on the remote server to the QQ webhook listener in the container.
MINICLAW_PODMAN_QQ_PORT=18080
MINICLAW_PODMAN_QQ_CONTAINER_PORT=18080

# Remote Podman mounts.
MINICLAW_PODMAN_CONFIG=/root/.config/miniclaw/config
MINICLAW_PODMAN_MCP_CONFIG=/root/.config/miniclaw/mcp.json