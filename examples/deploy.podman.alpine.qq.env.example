# Copy this file to ./.deploy.podman.qq.env, adjust values if needed, then run:
#   set -a && source ./.deploy.podman.qq.env && set +a
#   ./scripts/deploy_podman_alpine.sh

MINICLAW_GATEWAY_CHANNEL=qq
MINICLAW_LINUX_ARCH=amd64

# Podman build and runtime identity.
MINICLAW_PODMAN_IMAGE=miniclaw:alpine
MINICLAW_PODMAN_CONTAINER=miniclaw-qq

# Persistent host state for this container.
MINICLAW_PODMAN_STATE_ROOT=$PWD/.podman/miniclaw-qq
MINICLAW_PODMAN_ENV_FILE=$PWD/.podman/miniclaw-qq/miniclaw.env
MINICLAW_PODMAN_HOME=$PWD/.podman/miniclaw-qq/home

# Host port published to the QQ webhook listener in the container.
MINICLAW_PODMAN_QQ_PORT=18080
MINICLAW_PODMAN_QQ_CONTAINER_PORT=18080

# Optional: mount a custom MCP config instead of the image default.
MINICLAW_PODMAN_MCP_CONFIG=