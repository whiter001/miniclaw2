[Unit]
Description=MiniClaw Weixin Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=miniclaw
Group=miniclaw
WorkingDirectory=/opt/miniclaw
EnvironmentFile=/etc/miniclaw/miniclaw-weixin.env
ExecStart=/opt/miniclaw/miniclaw gateway --channel weixin
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/miniclaw/weixin
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target