# Copy this file to ./.deploy.podman.weixin.env, adjust values if needed, then run:
#   set -a && source ./.deploy.podman.weixin.env && set +a
#   ./scripts/deploy_podman_alpine.sh

MINICLAW_GATEWAY_CHANNEL=weixin
MINICLAW_LINUX_ARCH=amd64

# Podman build and runtime identity.
MINICLAW_PODMAN_IMAGE=miniclaw:alpine
MINICLAW_PODMAN_CONTAINER=miniclaw-weixin

# Persistent host state for this container.
MINICLAW_PODMAN_STATE_ROOT=$PWD/.podman/miniclaw-weixin
MINICLAW_PODMAN_ENV_FILE=$PWD/.podman/miniclaw-weixin/miniclaw.env
MINICLAW_PODMAN_HOME=$PWD/.podman/miniclaw-weixin/home

# First deploy: open the QR login flow automatically when no stored account exists.
MINICLAW_PODMAN_WEIXIN_LOGIN=1
MINICLAW_PODMAN_WEIXIN_LOGIN_TIMEOUT=8m

# Optional: mount a custom MCP config instead of the image default.
MINICLAW_PODMAN_MCP_CONFIG=