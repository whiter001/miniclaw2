# Copy this file to ./.deploy.qq.env, adjust values if needed, then run:
#   set -a && source ./.deploy.qq.env && set +a
#   ./scripts/deploy_bl.sh
#
# Run from the repository root. This template is intended to coexist with the
# Weixin template for side-by-side deployment on the same server.

# SSH target
MINICLAW_DEPLOY_HOST=bl
MINICLAW_REMOTE_USER=root

# Remote paths. The code and MCP config can be shared with Weixin, but the env
# file, service name, and runtime state should stay separate.
MINICLAW_REMOTE_HOME=/root
MINICLAW_REMOTE_REPO=/bl/project/miniclaw/repo
MINICLAW_REMOTE_ENV_FILE=/etc/miniclaw/miniclaw-qq.env
MINICLAW_REMOTE_CONFIG=/root/.config/miniclaw/config
MINICLAW_REMOTE_MCP_CONFIG=/root/.config/miniclaw/mcp.json
MINICLAW_REMOTE_SERVICE=miniclaw-qq
MINICLAW_REMOTE_APP_HOME=/var/lib/miniclaw/qq
MINICLAW_REMOTE_WORKSPACE=/var/lib/miniclaw/qq/workspace

# Gateway mode
MINICLAW_GATEWAY_CHANNEL=qq
MINICLAW_LINUX_ARCH=amd64
MINICLAW_REMOTE_WEBHOOK_PORT=18080

# Weixin-only variables kept here for completeness. They are ignored for QQ.
MINICLAW_REMOTE_WEIXIN_LOGIN=0
MINICLAW_REMOTE_WEIXIN_LOGIN_TIMEOUT=8m

# Optional systemd resource limits
MINICLAW_SERVICE_MEMORY_HIGH=320M
MINICLAW_SERVICE_MEMORY_MAX=356M
MINICLAW_SERVICE_CPU_QUOTA=50%
MINICLAW_SERVICE_TASKS_MAX=64